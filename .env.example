# Copy to .env and fill locally. Never commit .env. Names only here.

# SERV Reasoning (OpenServ) - https://docs.openserv.ai/serv-reasoning/introduction.md
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai/v1
# Model IDs (see docs/SPEC.md section 5). Feature suffixes like -serv-multipath / -serv-kronos go here, not in code.
AFC_MODEL_PLANNER=gpt-5.4-mini-serv-multipath
AFC_MODEL_RUBRIC=gpt-5.4-mini-serv-kronos-multipath
AFC_MODEL_SUMMARY=gpt-6-luna
AFC_MODEL_EXPLAIN=gpt-5.4-mini-serv-multipath
AFC_MODEL_FRAUD=claude-sonnet-5-serv-kronos-multipath
AFC_MODEL_MAPPER=gpt-6-luna

# Reppo Evaluation API - https://docs.reppo.ai/api/eval/overview.md
REPPO_API_KEY=
REPPO_BASE_URL=https://eval.reppo.xyz/api/v1
REPPO_SETTLEMENT_MINUTES=10

# Kite chain (read-only explorer + RPC) - https://docs.gokite.ai/kite-chain/1-getting-started/network-information.md
KITE_NETWORK=mainnet
KITESCAN_API_BASE=https://kitescan.ai/api/v2
KITE_RPC_URL=https://rpc.gokite.ai
KITE_USDC_ADDRESS=0x7aB6f3ed87C42eF0aDb67Ed95090f8bF5240149e

# App
AFC_DB_PATH=./data/agentfico.sqlite
AFC_OFFLINE=1
PORT=8787
WEB_PORT=5173
